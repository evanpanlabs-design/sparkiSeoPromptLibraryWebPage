# Sparki Environment Variables Template
# Copy this file to .env and fill in your actual values
# .env is git-ignored — never commit actual keys

# ── LLM API (MiniMax / OpenAI-compatible) ─────────────────────────────────────
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.minimaxi.com/v1

# Model name (used for extraction, scoring, query expansion)
# See https://api.minimaxi.com/v1/models for available models
LLM_MODEL=MiniMax-M2.7

# ── Google Cloud / Vertex AI (for Gemini image generation) ────────────────────
# Authenticate via: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON key path
GOOGLE_CLOUD_PROJECT=sparki-op
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# GCS bucket (must exist and be writable by the authenticated account)
GCS_BUCKET=sparki-op-test

# Image generation model(s) — comma-separated priority list
# Available: gemini-3-pro-image-preview, gemini-3.1-flash-image-preview, gemini-2.5-flash-image
IMAGE_MODEL=gemini-3-pro-image-preview

# ── Proxy (optional) ────────────────────────────────────────────────────────────
# Leave empty to disable proxy
PROXY_SERVER=http://127.0.0.1:7897

# ── X.com Authentication ────────────────────────────────────────────────────────
# Cookies are stored in outputs/cookies.json by browser_auth.py
# Run: python -m src.crawler.browser_auth
# No env var needed — cookies are file-based

# ── Optional: Custom paths ──────────────────────────────────────────────────────
# SCRAPE_DB_PATH=data/sparki.db
# OUTPUT_DIR=outputs